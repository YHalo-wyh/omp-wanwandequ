{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wanwandequ Studio",
  "version": "0.3.0",
  "identifier": "cn.yhalo.wanwandequ.studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "万万得取 Studio",
        "width": 1560,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/omp-wanwandequ"],
    "shortDescription": "OMP-Wanwandequ 中文 CTF 智能工作台",
    "longDescription": "面向 OMP-Wanwandequ 的桌面 CTF IDE：中文对话、可交互工作区、原生 PTY、比赛状态、上下文与工具调用观测，以及真实运行配置。",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
