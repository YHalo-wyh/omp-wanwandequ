{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wanwandequ Studio",
  "version": "0.4.0",
  "identifier": "cn.yhalo.wanwandequ.studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "万万得取 Studio",
        "width": 1560,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/omp-wanwandequ"],
    "shortDescription": "Wanwandequ Runtime 的中文 CTF 客户端",
    "longDescription": "面向 Wanwandequ Headless Runtime 的桌面客户端：通过 OMP 原生 JSONL RPC 连接 AgentSession，提供中文对话、工作区、比赛状态、真实工具与 Subagent 事件、上下文和运行配置；正式比赛仍由独立 headless Agent 执行。",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
